# Frontend Next.js — imagen de DESARROLLO (hot reload, no optimizada para prod)
FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

# Solo los manifests primero: la capa de dependencias se cachea y no se
# reinstala cada vez que cambia el codigo.
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/a2ui/package.json ./packages/a2ui/
COPY packages/catalog/package.json ./packages/catalog/
RUN pnpm install --filter web...

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["pnpm", "--filter", "web", "dev"]
